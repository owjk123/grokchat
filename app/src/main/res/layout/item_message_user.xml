<?xml version="1.0" encoding="utf-8"?>
<!--
  User message: right-aligned, gold bubble.
  Left margin = 64dp pushes bubble right (ensures max ~72% screen width on 360dp devices).
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="end"
    android:orientation="vertical"
    android:paddingStart="64dp"
    android:paddingEnd="0dp"
    android:paddingTop="2dp"
    android:paddingBottom="2dp">

    <!-- Image attachment -->
    <ImageView
        android:id="@+id/ivAttachment"
        android:layout_width="200dp"
        android:layout_height="150dp"
        android:background="@drawable/bubble_user_img"
        android:clipToOutline="true"
        android:outlineProvider="background"
        android:scaleType="centerCrop"
        android:visibility="gone"
        android:layout_marginBottom="3dp" />

    <!-- Text bubble -->
    <TextView
        android:id="@+id/tvContent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bubble_user"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:textColor="#161616"
        android:textSize="15sp"
        android:fontFamily="sans-serif"
        android:lineSpacingMultiplier="1.4"
        android:visibility="gone" />

</LinearLayout>
