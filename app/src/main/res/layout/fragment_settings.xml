<?xml version="1.0" encoding="utf-8"?>
<!--
  Settings: Carbon Design System form layout.
  Section labels: 10sp uppercase gold eyebrow (like Carbon's form labels).
  Fields: OutlinedBox Dense with 4dp corners.
  Dividers: 1dp colorBorderSubtle between sections.
-->
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- API Key section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                style="@style/GrokChat.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_api_key"
                android:layout_marginBottom="10dp" />

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.GrokChat.TextInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etApiKey"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/hint_api_key"
                    android:inputType="textPassword"
                    android:textColor="@color/colorTextPrimary"
                    android:textColorHint="@color/colorTextSecondary"
                    android:textSize="14sp"
                    android:background="@android:color/transparent" />

            </com.google.android.material.textfield.TextInputLayout>

        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/colorBorderSubtle" />

        <!-- Endpoint section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                style="@style/GrokChat.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_endpoint"
                android:layout_marginBottom="10dp" />

            <Spinner
                android:id="@+id/spinnerEndpoint"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@color/colorCard"
                android:paddingStart="12dp" />

        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/colorBorderSubtle" />

        <!-- Model section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                style="@style/GrokChat.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_model"
                android:layout_marginBottom="10dp" />

            <Spinner
                android:id="@+id/spinnerModel"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@color/colorCard"
                android:paddingStart="12dp" />

        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/colorBorderSubtle" />

        <!-- Save button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSave"
                style="@style/Widget.GrokChat.GoldButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="@string/save" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
